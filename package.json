{
  "name": "o-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A floating Material-style dashboard for GNOME Shell: weather, calendar, MPRIS music, live system stats, notifications, and an app launcher with search + categories.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && prettier --write \"dist/**/*.js\"",
    "lint": "eslint .",
    "watch": "tsc -p tsconfig.json --watch",
    "format": "prettier --write \"**/*.{ts,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@girs/gjs": "^4.1.0",
    "@girs/gnome-shell": "^50.0.4",
    "@girs/soup-3.0": "^4.1.0",
    "@tsconfig/strictest": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
